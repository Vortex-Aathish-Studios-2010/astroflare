# Astroflare configuration.
# 1. Copy this file to a new file named exactly ".env" (same folder).
# 2. Replace the placeholder below with your own key. No quotes or spaces needed.
# 3. Restart the server after any change.
# The .env file is private: never share it, commit it, or paste its contents anywhere.

# ---- Optional generated explanation: choose ONE service -------------------------------------
# The assessment itself needs no key. This only enables the optional, unreviewed explanation text.
# anthropic  (default) Anthropic's Claude. Needs ANTHROPIC_API_KEY below.
# freellmapi           A FreeLLMAPI router running on your computer (https://github.com/tashfeenahmed/freellmapi).
#                      Pools free-tier models; quality varies; meant for personal experimentation.
# AI_PROVIDER=anthropic

# Anthropic: get a key at https://console.anthropic.com (Settings > API Keys). Real keys start with sk-ant-
ANTHROPIC_API_KEY=your-anthropic-key-here
# Optional: which Claude model writes the brief. Leave out to use the default.
# Current model IDs: https://platform.claude.com/docs/en/models/overview
# ANTHROPIC_MODEL=claude-sonnet-5-5

# FreeLLMAPI (only used when AI_PROVIDER=freellmapi):
# Copy the unified key (starts with freellmapi-) from the router dashboard's Keys page.
# FREELLMAPI_API_KEY=
# Where the router listens, ending in /v1. Usually leave this out:
#  - Windows desktop app: Astroflare reads the port from %APPDATA%\FreeLLMAPI\config.json (31415 by default, NOT 3001)
#  - Docker/server install: http://127.0.0.1:3001/v1 (the fallback when no desktop app is found)
# Plain http is only accepted for localhost / 127.0.0.1.
# FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
# One model, or several separated by commas, tried in order (up to 5). Use models YOUR account can really use:
# FreeLLMAPI's catalog still lists models Google has retired (e.g. gemini-2.5-flash). "python check_keys.py" tests them.
# "auto" lets the router choose but can be slow (it may try retired models first).
# FREELLMAPI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash

# ---- Solar activity ------------------------------------------------------------------------
# Solar-flare data comes from NASA's official DONKI service, which needs NO key,
# so you can leave everything below alone.
# Advanced: NASA_SOURCE=gateway uses the api.nasa.gov gateway instead, which does need a key
# (free at https://api.nasa.gov; blank = the shared DEMO_KEY, ~30 requests per hour).
# As of October 2026 that gateway still points at NASA's retired DONKI server and returns HTTP 503.
# NASA_SOURCE=gateway
# NASA_API_KEY=

# ---- Server --------------------------------------------------------------------------------
# Optional: change the port (then open http://127.0.0.1:<port>)
# PORT=8000
# Developer mode: enables /api/admin/status, /api/brief and a "diagnostics" object in /api/report
# (provider and model detail, never key values). Leave unset for ordinary use.
# ASTROFLARE_DEVELOPER_MODE=1
# Public deployment (set by render.yaml; leave unset on your own computer):
# ASTROFLARE_ENV=production            listens on 0.0.0.0, disables developer mode, adds per-visitor limits
# ASTROFLARE_ALLOWED_HOSTS=your-site.example.com
# ASTROFLARE_AI_RATE_PER_MIN=12        site-wide text-service calls per minute
